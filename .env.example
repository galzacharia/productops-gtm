# ---- Jira connection (server-side only; never exposed to the browser) ----
# Your Atlassian site base URL
JIRA_BASE_URL=https://papayaglobal.atlassian.net

# The Atlassian account email that owns the API token
JIRA_EMAIL=you@papayaglobal.com

# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_atlassian_api_token

# ---- Quarterly label convention ----
# Label pulled is  <PREFIX>_Q<quarter><two-digit-year>   e.g. Product_Q326 = Q3 2026
LABEL_PREFIX=Product

# Only pull epics (recommended). Set to false to include every issue type carrying the label.
EPICS_ONLY=true

# ---- Server ----
PORT=8787

# ---- Overlay store ----
# Where the app-side GTM/ProductOps overlay JSON is written.
OVERLAY_FILE=./data/overlay.json
